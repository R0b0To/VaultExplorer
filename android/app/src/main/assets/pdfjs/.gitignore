# pdf.js library files -- built from source by scripts/build_pdfjs.sh,
# invoked automatically by Gradle's preBuild task. Not committed, same
# reasoning as android/app/src/main/cpp/ffmpeg/ used to have before ffmpeg
# was removed: F-Droid (and everyone else) should build this from source,
# not trust a committed prebuilt blob.
#
# viewer.js/.html/.css are NOT covered by this -- those are this project's
# own code and must stay tracked.
pdf.min.mjs
pdf.worker.min.mjs
