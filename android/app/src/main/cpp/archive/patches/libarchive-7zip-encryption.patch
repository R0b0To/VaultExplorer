+static int
+init_7zip_aes_decryption(struct archive_read *a, struct _7zip *zip,
+	const struct _7z_coder *coder, int64_t plaintext_size)
+{
+	const unsigned char *props = coder->properties;
+	const char *passphrase = zip->aes_passphrase;
+	unsigned char key[32], iv[16] = {0};
+	unsigned char flags;
+	size_t salt_len = 0, iv_len = 0, offset = 1;
+	const unsigned char *salt = NULL, *ivp = NULL;
+	int ret = ARCHIVE_FAILED;
+
+	clear_7zip_aes(zip);
+	if (coder->propertiesSize < 1 || props == NULL) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Malformed 7-Zip AES properties");
+		return (ARCHIVE_FAILED);
+	}
+	flags = props[0];
+	if (flags & 0x80 || flags & 0x40) {
+		if (coder->propertiesSize < 2) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "Malformed 7-Zip AES properties");
+			return (ARCHIVE_FAILED);
+		}
+		salt_len = (flags & 0x80) ? ((props[1] >> 4) & 0x0F) + 1 : 0;
+		iv_len = (flags & 0x40) ? (props[1] & 0x0F) + 1 : 0;
+		offset = 2;
+	}
+	if (salt_len > 16 || iv_len > 16 || salt_len + iv_len > coder->propertiesSize - offset) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Malformed 7-Zip AES salt or IV");
+		return (ARCHIVE_FAILED);
+	}
+	salt = props + offset;
+	ivp = salt + salt_len;
+	if (iv_len > 0)
+		memcpy(iv, ivp, iv_len);
+	if (passphrase == NULL) {
+		/*
+		 * The passphrase queue has to be rewound before it is walked,
+		 * otherwise the first candidate is never returned.
+		 */
+		__archive_read_reset_passphrase(a);
+		passphrase = __archive_read_next_passphrase(a);
