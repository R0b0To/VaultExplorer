+#ifdef HAVE_LIBCRYPTO
+static void
+clear_7zip_aes(struct _7zip *zip)
+{
+	if (zip->aes_ctx != NULL)
+		EVP_CIPHER_CTX_free(zip->aes_ctx);
+	zip->aes_ctx = NULL;
+	if (zip->aes_buffer != NULL) {
+		volatile unsigned char *p = zip->aes_buffer;
+		size_t n = UBUFF_SIZE;
+		while (n-- > 0)
+			*p++ = 0;
+		free(zip->aes_buffer);
+	}
+	zip->aes_buffer = NULL;
+	zip->aes_buffer_offset = 0;
+	zip->aes_buffer_remaining = 0;
+	zip->aes_plaintext_remaining = 0;
+	zip->aes_active = 0;
+}
+
+static void
+free_7zip_aes(struct _7zip *zip)
+{
+	clear_7zip_aes(zip);
+	if (zip->aes_passphrase != NULL) {
+		volatile unsigned char *p = (unsigned char *)zip->aes_passphrase;
+		size_t n = strlen(zip->aes_passphrase) + 1;
+		while (n-- > 0)
+			*p++ = 0;
+		free(zip->aes_passphrase);
+		zip->aes_passphrase = NULL;
+	}
+	sevenzip_zero(zip->aes_key, sizeof(zip->aes_key));
+	zip->aes_key_valid = 0;
+}
