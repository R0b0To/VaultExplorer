+/*
+ * Encrypt 'len' bytes (a multiple of the block size) and write them out.
+ */
+static int
+aes_encrypt_blocks(struct archive_write *a, const uint8_t *data, size_t len)
+{
+	struct _7zip *zip = a->format_data;
