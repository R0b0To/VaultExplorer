+	    EVP_EncryptInit_ex(zip->aes.ctx, EVP_aes_256_cbc(), NULL,
+		zip->aes.key, iv) != 1 ||
+	    EVP_CIPHER_CTX_set_padding(zip->aes.ctx, 0) != 1) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Can't set up 7-Zip AES encryption");
+		secure_zero(iv, sizeof(iv));
+		return (ARCHIVE_FATAL);
+	}
+	secure_zero(iv, sizeof(iv));
