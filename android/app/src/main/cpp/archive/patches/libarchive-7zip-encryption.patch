+	 * no salt); byte 1 = (salt size - 1) << 4 | (IV size - 1).
+	 */
+	zip->aes.props[0] = (uint8_t)(AES_NUM_CYCLES_POWER | 0x40);
+	zip->aes.props[1] = (uint8_t)(AES_BLOCK_SIZE - 1);
