+static int
+sevenzip_utf8_to_utf16le(const char *s, unsigned char **out, size_t *out_len)
+{
+	const unsigned char *p = (const unsigned char *)s;
+	size_t input_len = strlen(s), cap, used = 0;
+	unsigned char *dst;
+
+	if (input_len > (SIZE_MAX - 2) / 2)
+		return (-1);
+	cap = input_len * 2 + 2;
+	dst = malloc(cap);
+	if (dst == NULL)
+		return (-1);
+
+	while (*p != 0) {
+		uint32_t cp;
+		int extra, i;
+		static const uint32_t min_cp[] = {0, 0x80, 0x800, 0x10000};
+
+		if (*p < 0x80) { cp = *p; extra = 0; }
+		else if ((*p & 0xE0) == 0xC0) { cp = *p & 0x1F; extra = 1; }
+		else if ((*p & 0xF0) == 0xE0) { cp = *p & 0x0F; extra = 2; }
+		else if ((*p & 0xF8) == 0xF0) { cp = *p & 0x07; extra = 3; }
+		else { free(dst); return (-1); }
+		p++;
+		for (i = 0; i < extra; i++, p++) {
+			if ((*p & 0xC0) != 0x80) { free(dst); return (-1); }
+			cp = (cp << 6) | (*p & 0x3F);
+		}
+		if (cp < min_cp[extra] || cp > 0x10FFFF ||
+		    (cp >= 0xD800 && cp <= 0xDFFF)) {
+			free(dst);
+			return (-1);
+		}
+		if (cp >= 0x10000) {
+			cp -= 0x10000;
+			archive_le16enc(dst + used, (uint16_t)(0xD800 | (cp >> 10)));
+			archive_le16enc(dst + used + 2,
+			    (uint16_t)(0xDC00 | (cp & 0x3FF)));
+			used += 4;
+		} else {
+			archive_le16enc(dst + used, (uint16_t)cp);
+			used += 2;
+		}
+	}
+	*out = dst;
+	*out_len = used;
+	return (0);
+}
+
+static void
+sevenzip_zero(void *p, size_t n)
+{
+	volatile unsigned char *v = p;
+	while (n-- > 0)
+		*v++ = 0;
+}
