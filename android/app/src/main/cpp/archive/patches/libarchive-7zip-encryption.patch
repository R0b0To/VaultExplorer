+/*
+ * 7-Zip hashes the password as UTF-16LE. Convert a UTF-8 passphrase into
+ * that form; 'out' must hold 2 * strlen(s) bytes. Returns the number of
+ * bytes produced or -1 if the passphrase is not well-formed UTF-8.
+ */
+static ssize_t
+utf8_to_utf16le(const char *s, uint8_t *out)
+{
+	static const uint32_t min_cp[4] = { 0, 0x80, 0x800, 0x10000 };
+	const unsigned char *p = (const unsigned char *)s;
+	uint8_t *o = out;
+
+	while (*p) {
+		uint32_t c;
+		int extra, n;
+
+		if (*p < 0x80) { c = *p; extra = 0; }
+		else if ((*p & 0xE0) == 0xC0) { c = *p & 0x1F; extra = 1; }
+		else if ((*p & 0xF0) == 0xE0) { c = *p & 0x0F; extra = 2; }
+		else if ((*p & 0xF8) == 0xF0) { c = *p & 0x07; extra = 3; }
+		else
+			return (-1);
+		p++;
+		for (n = 0; n < extra; n++, p++) {
+			if ((*p & 0xC0) != 0x80)
+				return (-1);
+			c = (c << 6) | (*p & 0x3F);
+		}
+		if (c < min_cp[extra] || c > 0x10FFFF ||
+		    (c >= 0xD800 && c <= 0xDFFF))
+			return (-1);
+		if (c >= 0x10000) {
+			uint32_t hi, lo;
+
+			c -= 0x10000;
+			hi = 0xD800 | (c >> 10);
+			lo = 0xDC00 | (c & 0x3FF);
+			archive_le16enc(o, (uint16_t)hi);
+			archive_le16enc(o + 2, (uint16_t)lo);
+			o += 4;
+		} else {
+			archive_le16enc(o, (uint16_t)c);
+			o += 2;
+		}
+	}
+	return ((ssize_t)(o - out));
