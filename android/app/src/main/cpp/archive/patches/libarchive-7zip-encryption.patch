+		    (int)n) != 1 || (size_t)outl != n) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "7-Zip AES encryption failed");
+			return (ARCHIVE_FATAL);
+		}
+		if (write_to_temp(a, out, n) != ARCHIVE_OK)
+			return (ARCHIVE_FATAL);
+		zip->aes.out_bytes += n;
+		data += n;
+		len -= n;
+	}
