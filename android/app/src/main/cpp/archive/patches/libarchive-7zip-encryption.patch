+static int
+sevenzip_derive_key(struct archive_read *a, const char *passphrase,
+	const unsigned char *salt, size_t salt_len, unsigned cycles_power,
+	unsigned char key[32])
+{
+	unsigned char *password = NULL, *batch = NULL;
+	EVP_MD_CTX *md = NULL;
+	size_t password_len = 0, record_len, per_batch, batch_bytes;
+	uint64_t rounds, pos;
+	unsigned int digest_len = 0;
+	int ret = ARCHIVE_FAILED;
+
+	if (sevenzip_utf8_to_utf16le(passphrase, &password, &password_len) != 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "7-Zip passphrase is not valid UTF-8");
+		return (ARCHIVE_FAILED);
+	}
+	if (cycles_power == 0x3F) {
+		size_t copied = 0;
+		memset(key, 0, 32);
+		if (salt_len > 32)
+			salt_len = 32;
+		memcpy(key, salt, salt_len);
+		copied = salt_len;
+		if (password_len > 32 - copied)
+			password_len = 32 - copied;
+		memcpy(key + copied, password, password_len);
+		ret = ARCHIVE_OK;
+		goto cleanup;
+	}
+	if (cycles_power > 24) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Unsupported 7-Zip AES key derivation strength");
+		goto cleanup;
+	}
+	if (salt_len > SIZE_MAX - password_len - 8) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "Invalid 7-Zip AES parameters");
+		goto cleanup;
+	}
+	record_len = salt_len + password_len + 8;
+	per_batch = record_len == 0 ? 1 : 4096 / record_len;
+	if (per_batch == 0)
+		per_batch = 1;
+	if (per_batch > 4096 / record_len)
+		per_batch = 4096 / record_len;
+	if (per_batch == 0)
+		per_batch = 1;
+	if (per_batch > SIZE_MAX / record_len) {
+		archive_set_error(&a->archive, ENOMEM,
+		    "Can't allocate memory for 7-Zip key derivation");
+		goto cleanup;
+	}
+	batch_bytes = per_batch * record_len;
+	batch = malloc(batch_bytes);
+	md = EVP_MD_CTX_new();
+	if (batch == NULL || md == NULL ||
+	    EVP_DigestInit_ex(md, EVP_sha256(), NULL) != 1) {
+		archive_set_error(&a->archive, ENOMEM,
+		    "Can't set up 7-Zip key derivation");
+		goto cleanup;
+	}
+	rounds = (uint64_t)1 << cycles_power;
+	for (pos = 0; pos < rounds;) {
+		uint64_t count = rounds - pos;
+		uint64_t i;
+		if (count > per_batch)
+			count = per_batch;
+		for (i = 0; i < count; i++) {
+			unsigned char *record = batch + (size_t)i * record_len;
+			memcpy(record, salt, salt_len);
+			memcpy(record + salt_len, password, password_len);
+			archive_le64enc(record + salt_len + password_len, pos + i);
+		}
+		if (EVP_DigestUpdate(md, batch, (size_t)count * record_len) != 1) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "7-Zip key derivation failed");
+			goto cleanup;
+		}
+		pos += count;
+	}
+	if (EVP_DigestFinal_ex(md, key, &digest_len) != 1 || digest_len != 32) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "7-Zip key derivation failed");
+		goto cleanup;
+	}
+	ret = ARCHIVE_OK;
+cleanup:
+	if (md != NULL)
+		EVP_MD_CTX_free(md);
+	if (batch != NULL) {
+		sevenzip_zero(batch, batch_bytes);
+		free(batch);
+	}
+	if (password != NULL) {
+		sevenzip_zero(password, strlen(passphrase) * 2 + 2);
+		free(password);
+	}
+	return (ret);
+}
