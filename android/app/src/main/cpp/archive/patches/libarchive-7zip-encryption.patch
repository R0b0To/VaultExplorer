+/*
+ * 7zAES key: SHA-256 over (salt || password || round counter) for
+ * 2^AES_NUM_CYCLES_POWER rounds, all fed to one running hash. The salt is
+ * empty, as 7-Zip itself writes it.
+ */
+static int
+aes_derive_key(struct archive_write *a, const char *passphrase,
+    uint8_t key[32])
+{
+	const uint64_t rounds = (uint64_t)1 << AES_NUM_CYCLES_POWER;
+	size_t plen = strlen(passphrase);
+	uint8_t *pw, *buf = NULL;
+	EVP_MD_CTX *md = NULL;
+	unsigned int mdlen = 0;
+	size_t rlen = 0, per = 0;
+	ssize_t pwlen;
+	uint64_t pos;
+	int ok = 0;
+
+	pw = malloc(2 * plen + 2);
+	if (pw == NULL) {
+		archive_set_error(&a->archive, ENOMEM,
+		    "Can't allocate memory for the 7-Zip passphrase");
+		return (ARCHIVE_FATAL);
+	}
+	pwlen = utf8_to_utf16le(passphrase, pw);
+	if (pwlen < 0) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "7-Zip passphrase is not valid UTF-8");
+		goto done;
+	}
+	rlen = (size_t)pwlen + 8;
+	per = 4096 / rlen;
+	if (per == 0)
+		per = 1;
+	buf = malloc(per * rlen);
+	md = EVP_MD_CTX_new();
+	if (buf == NULL || md == NULL ||
+	    EVP_DigestInit_ex(md, EVP_sha256(), NULL) != 1) {
+		archive_set_error(&a->archive, ENOMEM,
+		    "Can't set up 7-Zip key derivation");
+		goto done;
+	}
+	for (pos = 0; pos < rounds;) {
+		uint64_t n = rounds - pos;
+		uint64_t i;
+
+		if (n > per)
+			n = per;
+		for (i = 0; i < n; i++) {
+			memcpy(buf + i * rlen, pw, (size_t)pwlen);
+			archive_le64enc(buf + i * rlen + pwlen, pos + i);
+		}
+		if (EVP_DigestUpdate(md, buf, (size_t)n * rlen) != 1) {
+			archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+			    "7-Zip key derivation failed");
+			goto done;
+		}
+		pos += n;
+	}
+	if (EVP_DigestFinal_ex(md, key, &mdlen) != 1 || mdlen != 32) {
+		archive_set_error(&a->archive, ARCHIVE_ERRNO_MISC,
+		    "7-Zip key derivation failed");
+		goto done;
+	}
+	ok = 1;
+done:
+	if (md != NULL)
+		EVP_MD_CTX_free(md);
+	if (buf != NULL) {
+		secure_zero(buf, per * rlen);
+		free(buf);
+	}
+	secure_zero(pw, 2 * plen + 2);
+	free(pw);
+	return (ok ? ARCHIVE_OK : ARCHIVE_FATAL);
+}
